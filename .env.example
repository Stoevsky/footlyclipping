# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# Server Settings > Widget / Copy Server ID (Developer Mode)
DISCORD_GUILD_ID=

# ID od postoechkite kanali - NE gi kreirame povtorno
CHANNEL_VIRAL_ALERTS=
CHANNEL_LEADERBOARD=
CHANNEL_DAILY_ANALYTICS=
CHANNEL_CREATOR_GROWTH=
CHANNEL_FOOTLY_AI=
# Opciono za novi objavi
CHANNEL_NEW_VIDEOS=

# Viral.app > Organization > API > API Keys
VIRAL_API_KEY=
# Viral.app > Organization > API > Webhooks > Add Endpoint > Signing Secret (whsec_...)
VIRAL_WEBHOOK_SECRET=
# Opciono, za dodatna proverka na organizationId
VIRAL_ORG_ID=

# Railway Postgres DATABASE_URL ili drug hosted PostgreSQL
DATABASE_URL=
# Railway interno: false. Nadvoresen Postgres so TLS: true.
DATABASE_SSL=false
PORT=3000

# Pragovi za notifikacii
MIN_VIRAL_VIEWS=50000
MIN_FOLLOWERS=10000
# Dnevna statistika vo 09:00, Europe/Skopje
DAILY_REPORT_CRON=0 9 * * *
REPORT_TIMEZONE=Europe/Skopje

# Opcionalen AI: bez kluch /prasaj kje pokazhe poraka deka AI ne e aktiviran
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
