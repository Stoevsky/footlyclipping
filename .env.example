# Required secrets: enter directly in Railway service Variables, never in chat.
DISCORD_BOT_TOKEN=
VIRAL_API_KEY=
# Railway reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
DATABASE_SSL=false

# Discord Developer Portal application ID and authorized guild ID.
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Existing channel IDs; the bot never creates channels.
CHANNEL_VIRAL_ALERTS=
CHANNEL_LEADERBOARD=
CHANNEL_DAILY_ANALYTICS=
# Optional; falls back to CHANNEL_DAILY_ANALYTICS.
CHANNEL_WEEKLY_ANALYTICS=
CHANNEL_CREATOR_GROWTH=
CHANNEL_FOOTLY_AI=
# Optional: no new-video messages when omitted.
CHANNEL_NEW_VIDEOS=

# Optional webhook delivery: exact signing secret from Viral.app endpoint.
# Without this value POST /webhooks/viral-app rejects requests; polling still works.
VIRAL_WEBHOOK_SECRET=
# Optional organization-ID check for signed incoming events.
VIRAL_ORG_ID=
# Optional campaign-only scope; no organization analytics are shown when set.
VIRAL_CAMPAIGN_ID=
PORT=3000
MIN_VIRAL_VIEWS=10000
MIN_FOLLOWERS=10000
VIRAL_MILESTONES=10000,50000,100000,250000,500000,1000000,5000000,10000000
SYNC_INTERVAL_MINUTES=60
STARTUP_RETRY_MS=5000
REPORT_TIMEZONE=Europe/Skopje
# One wall-clock time per day; weekly reports are Monday.
DAILY_REPORT_CRON=0 9 * * *
WEEKLY_REPORT_CRON=0 9 * * 1

# Optional AI provider. Deterministic facts remain available without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
